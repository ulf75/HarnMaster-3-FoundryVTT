{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.maxTokenizationLineLength": 20000,
  "[html]": {
    "editor.formatOnSave": false
  },
  "editor.codeActionsOnSave": {
    "source.removeUnusedImports": "explicit"
  },
  "i18n-ally.localesPaths": ["lang"],
  "i18n-ally.displayLanguage": "en",
  "i18n-ally.preferredDelimiter": ".",
  // "i18n-ally.annotations": true,
  // "i18n-ally.pathMatcher": "{locale}.json",
  // "i18n-ally.sortKeys": true,
  // "i18n-ally.defaultNamespace": "hm3",
  "i18n-ally.translate.engines": ["deepl"],
  "i18n-ally.translate.deepl.apiKey": "xxx-xxx-xxx-xxx-xxx:xx",
  "i18n-ally.translate.deepl.useFreeApiEntry": true,
  "i18n-ally.keystyle": "nested",
  "[xml]": {
    "editor.defaultFormatter": "PrateekMahendrakar.prettyxml"
  },
  "todo-tree.highlights.defaultHighlight": {
    "icon": "alert",
    "type": "text-and-comment",
    "foreground": "black",
    "background": "white",
    "opacity": 50,
    "iconColour": "blue",
    "gutterIcon": true
  },
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "icon": "check",
      "foreground": "black",
      "background": "white",
      "iconColour": "white"
    },
    "NOTE": {
      "icon": "note",
      "foreground": "white",
      "background": "gray",
      "iconColour": "gray"
    },
    "BUG": {
      "foreground": "black",
      "background": "red",
      "iconColour": "red"
    },
    "[ ]": {
      "icon": "check",
      "foreground": "black",
      "background": "white",
      "iconColour": "yellow"
    },
    "[x]": {
      "icon": "check",
      "foreground": "white",
      "background": "green",
      "iconColour": "green"
    }
  },
  "todo-tree.general.tags": ["BUG", "HACK", "FIXME", "FIX", "TODO", "@todo", "NOTE", "COMMENT", "[ ]", "[x]"],
  "todo-tree.general.tagGroups": {
    "BUG": ["FIXME", "BUG", "HACK", "FIX"],
    "TODO": ["TODO", "@todo"],
    "NOTE": ["NOTE", "COMMENT"]
  },
  "todo-tree.regex.regex": "(//|#|<!--|/\\*|^\\s*\\*)\\s*($TAGS)",
  "todo-tree.filtering.excludeGlobs": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/bower_components/**",
    "**/build/**",
    "**/.vscode/**",
    "**/.github/**",
    "**/_output/**",
    "**/*.min.*",
    "**/*.map"
  ],
  "todo-tree.tree.tagsOnly": true,
  "todo-tree.tree.showCountsInTree": true
}
